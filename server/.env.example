# PostgreSQL connection string (Railway provides this automatically as DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/railway

# Port the API listens on (Railway sets PORT automatically)
PORT=3001

# Allowed CORS origin(s) — your Vercel URL. Comma-separated.
# IMPORTANT: with cookie auth you must list the exact origin(s); a bare "*" will
# not work together with credentials.
CORS_ORIGIN=https://your-app.vercel.app

# --- Auth (JWT) -------------------------------------------------------------
# Long random secrets for signing access / refresh tokens. Generate with e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NEVER commit real values — set them in Railway's variables.
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Auth cookie behaviour. Defaults are for cross-site prod (Vercel ↔ Railway):
#   COOKIE_SECURE=true, COOKIE_SAMESITE=none (requires HTTPS).
# For local http testing set COOKIE_SECURE=false and COOKIE_SAMESITE=lax.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# App timezone used to compute "today" / streaks (default Asia/Ho_Chi_Minh)
APP_TZ=Asia/Ho_Chi_Minh

# Set to "disable" to connect to a local Postgres without SSL
# PGSSL=disable
