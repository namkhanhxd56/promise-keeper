# PostgreSQL connection string (Railway provides this automatically as DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/railway

# Port the API listens on (Railway sets PORT automatically)
PORT=3001

# Allowed CORS origin(s) — your Vercel URL. Comma-separated, or * for any.
CORS_ORIGIN=https://your-app.vercel.app

# App timezone used to compute "today" / streaks (default Asia/Ho_Chi_Minh)
APP_TZ=Asia/Ho_Chi_Minh

# Set to "disable" to connect to a local Postgres without SSL
# PGSSL=disable
